# Для переменных окружения можно использовать префиксы:
# - "PROJECT_" — переменные с этим префиксом будут использоваться при запуске на сервере (в продакшене)
# - "DEVELOP_" — переменные с этим префиксом будут использоваться во время локальной разработки
# - Без префикса — такие переменные будут использоваться **в обоих случаях**, независимо от режима

# Переменная IS_PROJECT определяет настройки запуска проекта:
# - IS_PROJECT=True — запуск на сервере (режим продакшена)
# - IS_PROJECT=False — запуск локально (режим разработки)

# Переменная IS_DEBUG определяет уровень логирования:


IS_PROJECT=True
IS_DEBUG=True


# ====== Настройка SSH-туннеля ======
SSH_HOST=SSH_HOST
SSH_PORT=SSH_PORT
SSH_USER=SSH_USER
SSH_KEY_PATH=ssh_tunnel/id_rsa


# --------------- Настройки баз данных --------------
DB_ECHO=False

POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB
POSTGRES_HOST=POSTGRES_HOST
POSTGRES_PORT=POSTGRES_PORT

# Настройки FastAPI (project or development)
DEVELOP_FASTAPI_HOST = 127.0.0.1
PROJECT_FASTAPI_HOST = 0.0.0.0

DEVELOP_FASTAPI_PORT = 8000
PROJECT_FASTAPI_PORT = 8000


SECRET_KEY=SECRET_KEY
DOCS_USERNAME=DOCS_USERNAME
DOCS_PASSWORD=DOCS_PASSWORD